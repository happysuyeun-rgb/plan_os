# Copy to workers/crewai/.env (never commit real keys).
# Loopback disposable Supabase only for poll mode.

PLANOS_LOCAL_API_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Liner Router + Platform APIs — https://liner.com/developers/docs/search-agent-api
LINER_API_KEY=
PLANOS_LINER_BASE_URL=https://platform.liner.com/api/v1
PLANOS_LINER_MODEL=liner-gemini-router
PLANOS_CREWAI_PROVIDER=liner
PLANOS_CREWAI_MAX_CALLS_PER_RUN=8
PLANOS_LINER_TIMEOUT_SEC=320

# Market research budget (hackathon credit guard — no auto-loop)
PLANOS_MARKET_RESEARCH_MAX_CALLS=4
PLANOS_MARKET_RESEARCH_BUDGET_USD=5

# Set true to force no network calls (also auto when LINER_API_KEY empty)
PLANOS_CREWAI_DRY_RUN=false
