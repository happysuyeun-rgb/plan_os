VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 개발용 임시 로그인 (npm run dev 시 /login 에 표시)
VITE_DEV_LOGIN_EMAIL=dev@example.com
VITE_DEV_LOGIN_PASSWORD=dev123456

# AI 기획 검수 job 저장소 (기본: unset → browser / localStorage)
# server = 027 테이블 필요. 로컬은 scripts/apply-027-local-only.mjs + disposable만.
# Preview server 전환은 docs/plans/PREVIEW_027_APPLY_RUNBOOK_2026-10-25.md 승인 후에만.
# VITE_AI_REVIEW_STORE=browser
# VITE_AI_REVIEW_STORE=server

# S1 업무를 project_tasks에 생성 (기본: unset → off / prototype local)
# server-store accept는 linked_task_id FK 때문에 보통 true 필요 (CI disposable).
# VITE_S1_SERVER_TASKS=true

# dev:user 스크립트용 (Dashboard → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션용 (npm run db:push)
# Database → Connection string → URI (Session pooler 권장, Direct는 IPv6 환경에서 실패할 수 있음)
# 비밀번호에 @ 등 특수문자가 있으면 대괄호 [] 없이 그대로 붙여넣기 (스크립트가 자동 인코딩)
# 주의: 027은 migrations에 없음. db:push로 Preview/ops에 027을 넣지 말 것.
SUPABASE_DB_URL=
